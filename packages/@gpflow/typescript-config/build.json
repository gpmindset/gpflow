{
  "extends": "./base.json",
  "compilerOptions": {
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@gpflow/*": ["../*/dist"]
    }
  },
  "tsc-alias": {
    "replacers": {
      "base-url": {
        "enabled": true
      }
    }
  }
}
